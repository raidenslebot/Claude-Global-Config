{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CONFIG_ROOT:url}}/hooks/session-start-ui-stack.js\"",
            "timeout": 15,
            "statusMessage": "Loading UI/design resource stack"
          },
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CONFIG_ROOT:url}}/hooks/session-start-react-stack.js\"",
            "timeout": 15,
            "statusMessage": "Loading React tooling stack"
          },
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CONFIG_ROOT:url}}/hooks/session-start-security-stack.js\"",
            "timeout": 15,
            "statusMessage": "Loading Security tooling stack"
          },
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CONFIG_ROOT:url}}/hooks/session-start-graph.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CONFIG_ROOT:url}}/hooks/user-prompt-ui-stack.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CONFIG_ROOT:url}}/hooks/user-prompt-react-stack.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CONFIG_ROOT:url}}/hooks/user-prompt-security-stack.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CONFIG_ROOT:url}}/hooks/restore-dispatch.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CONFIG_ROOT:url}}/hooks/user-prompt-graph.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CONFIG_ROOT:url}}/hooks/user-prompt-visual.js\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CONFIG_ROOT:url}}/hooks/user-prompt-model-policy.js\"",
            "timeout": 10,
            "statusMessage": "Resolving model policy for spawned agents"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CONFIG_ROOT:url}}/hooks/post-tool-verify.js\"",
            "timeout": 10,
            "statusMessage": "Verifying written file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"{{NODE}}\" \"{{CONFIG_ROOT:url}}/hooks/stop-verify.js\"",
            "timeout": 15,
            "statusMessage": "Verifying the work before finishing"
          }
        ]
      }
    ]
  }
}
